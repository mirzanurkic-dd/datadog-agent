load("@rules_go//go:def.bzl", "go_library")
load("//bazel/rules/go:dd_agent_go_test.bzl", "dd_agent_go_test")

go_library(
    name = "symbol",
    srcs = [
        "elf.go",
        "elf_wrapper.go",
        "source.go",
    ],
    importpath = "github.com/DataDog/datadog-agent/comp/host-profiler/symboluploader/symbol",
    visibility = ["//visibility:public"],
    deps = select({
        "@rules_go//go/platform:android": [
            "//comp/host-profiler/symboluploader/pclntab",
            "//pkg/util/safeelf",
            "@io_opentelemetry_go_ebpf_profiler//libpf",
            "@io_opentelemetry_go_ebpf_profiler//libpf/pfelf",
            "@io_opentelemetry_go_ebpf_profiler//process",
        ],
        "@rules_go//go/platform:linux": [
            "//comp/host-profiler/symboluploader/pclntab",
            "//pkg/util/safeelf",
            "@io_opentelemetry_go_ebpf_profiler//libpf",
            "@io_opentelemetry_go_ebpf_profiler//libpf/pfelf",
            "@io_opentelemetry_go_ebpf_profiler//process",
        ],
        "//conditions:default": [],
    }),
)

dd_agent_go_test(
    name = "elf_reader_test",
    srcs = ["elf_reader_test.go"],
    embed = [":symbol"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = select({
        "@rules_go//go/platform:android": [
            "@com_github_stretchr_testify//require",
            "@io_opentelemetry_go_ebpf_profiler//libpf/pfelf",
        ],
        "@rules_go//go/platform:linux": [
            "@com_github_stretchr_testify//require",
            "@io_opentelemetry_go_ebpf_profiler//libpf/pfelf",
        ],
        "//conditions:default": [],
    }),
)
