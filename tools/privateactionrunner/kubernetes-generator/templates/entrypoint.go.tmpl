package com_datadoghq_kubernetes_{{ .Package }}

import "github.com/DataDog/datadog-agent/pkg/privateactionrunner/types"

type Kubernetes{{ .Package | title }} struct {
    actions map[string]types.Action
}

func NewKubernetes{{ .Package | title }}({{ if .RedactsSensitiveValues }}redactSensitiveValues bool{{ end }}) *Kubernetes{{ .Package | title }} {
    return &Kubernetes{{ .Package | title }}{
        actions: map[string]types.Action{
            // Manual actions
            {{ range .ManualActions -}}
            "{{ .Name }}": New{{ .Name | title }}Handler({{ if .RedactsSensitiveValues }}redactSensitiveValues{{ end }}),
            {{ end -}}
            // Auto-generated actions
            {{ range .Actions -}}
            "{{ .Name }}": New{{ .Name | title }}Handler({{ if .RedactsSensitiveValues }}redactSensitiveValues{{ end }}),
            {{ end -}}
        },
    }
}

func (h *Kubernetes{{ .Package | title }}) GetAction(actionName string) types.Action {
    return h.actions[actionName]
}
